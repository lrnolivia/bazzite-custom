{
  "name": "CapyMenu (QAM)",
  "display_name": "Chromahon (QAM)",
  "author": "Mugen",
  "version": "v3.0.1",
  "manifest_version": 9,
  "flags": [
    "REQUIRE_NAV_PATCH"
  ],
  "tabs": {
    "default": [
      "QuickAccess",
      "notificationtoasts.*"
    ]
  },
  "inject": {
    "qam_main.css": [],
    "qam_sidebar.css": [],
    "qam_paged-content.css": [],
    "qam_friends-page.css": [],
    "custom-template.css": []
  },
  "patches": {
    "\u27a4 Global Settings": {
      "type": "none",
      "values": {
        "_": {}
      }
    },
    "QAM Type": {
      "type": "slider",
      "default": "Regular",
      "values": {
        "Regular": {
          "tweaks/qam-type-regular.css": []
        },
        "Regular Rounded": {
          "tweaks/qam-type-regular_rounded.css": [],
          "tweaks/qam-rounded_shared-components.css": []
        },
        "Inverted": {
          "tweaks/qam-type-inverted.css": []
        },
        "Inverted Rounded": {
          "tweaks/qam-type-inverted_rounded.css": [],
          "tweaks/qam-rounded_shared-components.css": []
        }
      }
    },
    "Sidebar Layout": {
      "type": "slider",
      "default": "Collapse Top",
      "values": {
        "Standard": {
          "tweaks/sidebar-standard.css": []
        },
        "Collapse Center": {
          "tweaks/sidebar-collapse-center.css": []
        },
        "Collapse Top": {
          "tweaks/sidebar-collapse-top.css": []
        },
        "Collapse Bottom": {
          "tweaks/sidebar-collapse-bottom.css": []
        }
      }
    },
    "Show Sidebar Page Indicator": {
      "type": "checkbox",
      "default": "Yes",
      "values": {
        "Yes": {
          "tweaks/sidebar-page-indicator.css": []
        },
        "No": {}
      }
    },
    "Hide Help Page": {
      "type": "checkbox",
      "default": "Yes",
      "values": {
        "Yes": {
          "tweaks/sidebar-hide-help-page.css": []
        },
        "No": {}
      }
    },
    "Extend QAM Styling To Notification Toasts": {
      "type": "checkbox",
      "default": "Yes",
      "values": {
        "Yes": {
          "tweaks/notifToast-enable_style.css": []
        },
        "No": {}
      }
    },
    "\u27a4 Content Panel": {
      "type": "none",
      "values": {
        "_": {}
      }
    },
    "Content Panel Background Type": {
      "type": "slider",
      "default": "Solid Color",
      "values": {
        "Solid Color": {
          "parts/contentPanel/bg-solid.css": []
        },
        "IMG": {
          "parts/contentPanel/bg-img.css": []
        }
      },
      "components": [
        {
          "name": "Solid Color",
          "type": "color-picker",
          "on": "Solid Color",
          "default": "#0f0f0f",
          "css_variable": "chromahonQAM__Custom-main-bg",
          "tabs": []
        },
        {
          "name": "Image Picker",
          "type": "image-picker",
          "on": "IMG",
          "default": "",
          "css_variable": "chromahonQAM__Custom-main-bg",
          "tabs": []
        }
      ]
    },
    "Content Panel Foreground": {
      "type": "none",
      "values": {
        "_": {}
      },
      "components": [
        {
          "name": "Color",
          "type": "color-picker",
          "on": "_",
          "default": "#adadad",
          "css_variable": "chromahonQAM__Custom-main-fg",
          "tabs": []
        }
      ]
    },
    "Header Layer 1 Bg Type": {
      "type": "slider",
      "default": "Solid Colors",
      "values": {
        "Solid Colors": {
          "parts/pageHeader/bg-solid.css": [],
          "parts/dependencies/anim_colorChange-bg.css": []
        }
      },
      "components": [
        {
          "name": "Color 1",
          "type": "color-picker",
          "on": "Solid Colors",
          "default": "#d1d1d1",
          "css_variable": "--chromahonQAM__Custom-pageHeader-layer1-bg-c1",
          "tabs": []
        }
      ]
    },
    "Header Foreground": {
      "type": "none",
      "values": {
        "_": {}
      },
      "components": [
        {
          "name": "Color",
          "type": "color-picker",
          "on": "_",
          "default": "#202020",
          "css_variable": "chromahonQAM__Custom-pageHeader-layer1-fg",
          "tabs": []
