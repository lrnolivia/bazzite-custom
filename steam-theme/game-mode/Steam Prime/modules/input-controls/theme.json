    "Light Scheme Adjustments": {
      "type": "dropdown",
      "default": "Disabled",
      "values": {
        "Disabled": {},
        "Apply to Quick Access Menu": {
          "opt/schemeIsLight.css": []
        },
        "Apply to Steam Menu": {
          "opt/schemeIsLight.css": [
            "sm"
          ]
        },
        "Apply to both menus": {
          "opt/schemeIsLight.css": [
            "both"
          ]
        }
