  "display_name": "Chromahon (Input Controls)",
  "author": "Mugen",
  "version": "v1.0.0",
  "manifest_version": 9,
  "tabs": {
    "qam": [
      "QuickAccess"
    ],
    "sm": [
      "MainMenu"
    ],
    "both": [
      "MainMenu",
      "QuickAccess"
    ],
    "default": [
      "qam"
    ]
